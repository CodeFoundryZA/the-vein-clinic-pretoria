---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const { title, description = 'The Vein Clinic Pretoria - Expert varicose vein treatment by Dr. E Osman. Offering Radio Frequency Ablation, Sclerotherapy, HIFU, Steam Ablation, and more.' } = Astro.props;
const currentPath = Astro.url.pathname;

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/services', label: 'Services' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title} | The Vein Clinic Pretoria</title>

    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=AW-11547840578"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'AW-11547840578');
    </script>
  </head>
  <body class="min-h-screen flex flex-col bg-neutral-50">
    <!-- Header -->
    <header class="bg-white shadow-sm sticky top-0 z-50">
      <nav class="max-w-6xl mx-auto px-4 py-4 flex items-center justify-between">
        <a href="/" class="text-2xl font-bold text-primary" style="font-family: var(--font-heading);">
          The Vein Clinic
          <span class="block text-sm font-normal text-neutral-500">Pretoria</span>
        </a>

        <!-- Mobile menu button -->
        <button id="mobile-menu-btn" class="md:hidden p-2 text-neutral-600 hover:text-primary" aria-label="Toggle menu">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>

        <!-- Desktop nav -->
        <ul class="hidden md:flex items-center gap-6">
          {navLinks.map(link => (
            <li>
              <a
                href={link.href}
                class:list={[
                  'text-sm font-medium transition-colors hover:text-primary',
                  currentPath === link.href ? 'text-primary border-b-2 border-primary pb-1' : 'text-neutral-600'
                ]}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Mobile nav -->
      <div id="mobile-menu" class="hidden md:hidden border-t border-neutral-200">
        <ul class="px-4 py-2 space-y-2">
          {navLinks.map(link => (
            <li>
              <a
                href={link.href}
                class:list={[
                  'block py-2 text-sm font-medium transition-colors hover:text-primary',
                  currentPath === link.href ? 'text-primary' : 'text-neutral-600'
                ]}
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </header>

    <!-- Main content -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="bg-primary-dark text-white">
      <div class="max-w-6xl mx-auto px-4 py-12">
        <div class="grid md:grid-cols-3 gap-8">
          <div>
            <h3 class="text-lg font-bold mb-4">The Vein Clinic</h3>
            <p class="text-neutral-300 text-sm leading-relaxed">
              Expert diagnosis and treatment of varicose veins and venous disorders in Pretoria.
            </p>
          </div>
          <div>
            <h3 class="text-lg font-bold mb-4">Quick Links</h3>
            <ul class="space-y-2 text-sm">
              {navLinks.map(link => (
                <li>
                  <a href={link.href} class="text-neutral-300 hover:text-white transition-colors">
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
          <div>
            <h3 class="text-lg font-bold mb-4">Contact</h3>
            <p class="text-neutral-300 text-sm leading-relaxed">
              Room 405, Muelmed Hospital<br />
              577 Pretorius Street, Arcadia, Pretoria, 0083<br />
              Dr. E Osman<br />
              Tel: 012 440 0181 / 012 440 0803<br />
              Cell/WhatsApp: 084 568 0714<br />
              Email: veinclinicpretoria@gmail.com
            </p>
          </div>
        </div>
        <div class="border-t border-white/20 mt-8 pt-8 text-center text-neutral-400 text-sm">
          &copy; {new Date().getFullYear()} The Vein Clinic Pretoria. All rights reserved.
        </div>
      </div>
    </footer>

    <script>
      const btn = document.getElementById('mobile-menu-btn');
      const menu = document.getElementById('mobile-menu');
      btn?.addEventListener('click', () => {
        menu?.classList.toggle('hidden');
      });

      document.querySelectorAll('[data-contact-conversion]').forEach((link) => {
        link.addEventListener('click', () => {
          const googleTag = (window as typeof window & {
            gtag?: (...args: unknown[]) => void;
          }).gtag;

          googleTag?.('event', 'conversion', {
            send_to: 'AW-11547840578/gW7ACIqo6oEaEMKguIIr',
          });
        });
      });
    </script>
  </body>
</html>
