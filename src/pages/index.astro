---
import Layout from '../layouts/Layout.astro';

const services = [
  {
    title: 'Radio Frequency Ablation',
    desc: 'Uses radio waves to heat and close varicose veins. Done under local anaesthetic with sonar guidance.',
  },
  {
    title: 'Laser Treatment',
    desc: 'Endovenous laser fibre treats larger varicose veins via catheter, guided by duplex ultrasound.',
  },
  {
    title: 'Sclerotherapy',
    desc: 'Injection of liquid or foam sclerosant to close veins. Proven procedure used worldwide.',
  },
  {
    title: 'Glue Therapy',
    desc: 'Advanced VenaSeal system permanently treats varicose veins by gluing them closed.',
  },
  {
    title: 'MOCA',
    desc: 'Mechanico Chemical Ablation — a non-thermal, non-tumescent technique for varicose veins.',
  },
  {
    title: 'Ultrasound Diagnostics',
    desc: 'Gold standard duplex ultrasound scanning to diagnose and guide venous disease treatment.',
  },
];

const journeySteps = [
  { num: '01', title: 'Initial Consultation', desc: 'Clinical examination of the veins you are worried about by our specialist consultant.' },
  { num: '02', title: 'Understanding Your Condition', desc: 'We explain the underlying cause of varicose veins and what may happen if they are not treated.' },
  { num: '03', title: 'Treatment Discussion', desc: 'Best treatment practice per NICE guidelines and the options available to you.' },
  { num: '04', title: 'Duplex Ultrasound Scan', desc: 'A specialist sonographer provides a detailed map of your veins and identifies the causes.' },
  { num: '05', title: 'Personalised Treatment Plan', desc: 'Based on your scan results, a personalised treatment pathway is discussed and planned.' },
];
---

<Layout title="Home">
  <!-- Hero -->
  <section class="bg-gradient-to-br from-primary to-primary-dark text-white">
    <div class="max-w-6xl mx-auto px-4 py-24 md:py-32">
      <div class="max-w-2xl">
        <h1 class="text-4xl md:text-5xl font-bold leading-tight mb-6">
          Expert Varicose Vein Treatment in Pretoria
        </h1>
        <p class="text-lg md:text-xl text-neutral-200 mb-8 leading-relaxed">
          The Vein Clinic provides comprehensive diagnosis and minimally invasive treatment for varicose veins and venous disorders. Led by Dr. E Osman.
        </p>
        <div class="flex flex-wrap gap-4">
          <a href="https://app.elle.health/book-appointment?practice=8ujneQja%2BEUTnAYhIdK%2Fvw%3D%3D" target="_blank" rel="noopener noreferrer" class="inline-block bg-accent hover:bg-accent-light text-white font-semibold px-6 py-3 rounded-lg transition-colors">
            Book a Consultation
          </a>
          <a href="/services" class="inline-block bg-white/10 hover:bg-white/20 text-white font-semibold px-6 py-3 rounded-lg transition-colors border border-white/30">
            Our Treatments
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- About summary -->
  <section class="py-16 md:py-24">
    <div class="max-w-6xl mx-auto px-4">
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div>
          <h2 class="text-3xl font-bold text-primary mb-6">Understanding Varicose Veins</h2>
          <p class="text-neutral-600 leading-relaxed mb-4">
            Varicose veins are abnormally large, tortuous veins seen in the lower limbs. They result from increased venous pressure secondary to reflux through leaking valves. It is a progressive condition that worsens over time, which may lead to severe skin changes and chronic venous ulcers.
          </p>
          <p class="text-neutral-600 leading-relaxed mb-4">
            Common symptoms include leg swelling, pain, cramping, burning, itching, skin discolouration, and in severe cases, non-healing ulcers around the ankles.
          </p>
          <p class="text-neutral-600 leading-relaxed">
            Some cases may result from old clots in the deep venous system or rarely from a congenital condition called May Thurner syndrome.
          </p>
        </div>
        <div class="bg-primary/5 rounded-2xl p-8">
          <h3 class="text-xl font-bold text-primary mb-4">Risk Factors</h3>
          <ul class="space-y-3 text-neutral-600">
            <li class="flex items-start gap-3">
              <span class="text-accent mt-1">&ndash;</span>
              <span>More common in females</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-accent mt-1">&ndash;</span>
              <span>Increases with age</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-accent mt-1">&ndash;</span>
              <span>Family history</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-accent mt-1">&ndash;</span>
              <span>Pregnancy</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-accent mt-1">&ndash;</span>
              <span>Standing occupation</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-accent mt-1">&ndash;</span>
              <span>Obesity &amp; sedentary lifestyle</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-accent mt-1">&ndash;</span>
              <span>Prior injury or surgery</span>
            </li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Services grid -->
  <section class="py-16 md:py-24 bg-neutral-100">
    <div class="max-w-6xl mx-auto px-4">
      <div class="text-center mb-12">
        <h2 class="text-3xl font-bold text-primary mb-4">Our Treatments</h2>
        <p class="text-neutral-500 max-w-2xl mx-auto">We offer a comprehensive range of minimally invasive treatments tailored to your condition.</p>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {services.map(s => (
          <div class="bg-white rounded-xl p-6 shadow-sm hover:shadow-md transition-shadow">
            <h3 class="text-lg font-bold text-primary mb-2">{s.title}</h3>
            <p class="text-neutral-500 text-sm leading-relaxed">{s.desc}</p>
          </div>
        ))}
      </div>
      <div class="text-center mt-8">
        <a href="/services" class="inline-block bg-primary hover:bg-primary-light text-white font-semibold px-6 py-3 rounded-lg transition-colors">
          View All Services
        </a>
      </div>
    </div>
  </section>

  <!-- Your Journey -->
  <section class="py-16 md:py-24">
    <div class="max-w-4xl mx-auto px-4">
      <h2 class="text-3xl font-bold text-primary mb-10 text-center">Your Journey at The Vein Clinic</h2>
      <div class="space-y-0">
        {journeySteps.map((step, i) => (
          <div class="relative flex gap-6 pb-10 last:pb-0">
            {i < journeySteps.length - 1 && (
              <div class="absolute left-6 top-14 bottom-0 w-0.5 bg-neutral-200" />
            )}
            <div class="relative z-10 flex-shrink-0 w-12 h-12 bg-primary text-white rounded-full flex items-center justify-center font-bold text-sm">
              {step.num}
            </div>
            <div class="pt-1">
              <h3 class="text-lg font-bold text-primary mb-1">{step.title}</h3>
              <p class="text-neutral-600 leading-relaxed text-sm">{step.desc}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Contact -->
  <section id="contact" class="py-16 md:py-24 bg-neutral-100">
    <div class="max-w-4xl mx-auto px-4">
      <div class="text-center mb-10">
        <h2 class="text-3xl font-bold text-primary mb-4">Contact Us</h2>
        <p class="text-neutral-600">Book a consultation or get in touch with any questions.</p>
      </div>
      <div class="grid md:grid-cols-2 gap-8">
        <div>
          <div class="space-y-6">
            <div>
              <h3 class="font-bold text-neutral-700 mb-1">Specialist</h3>
              <p class="text-neutral-600">Dr. E Osman</p>
            </div>
            <div>
              <h3 class="font-bold text-neutral-700 mb-1">Location</h3>
              <p class="text-neutral-600">Pretoria, South Africa</p>
            </div>
            <div>
              <h3 class="font-bold text-neutral-700 mb-1">Services</h3>
              <p class="text-neutral-600 text-sm leading-relaxed">
                Varicose vein consultation, duplex ultrasound diagnostics, Radio Frequency Ablation, endovenous laser treatment, sclerotherapy, glue therapy, MOCA, and more.
              </p>
            </div>
          </div>
        </div>
        <div class="bg-white rounded-xl shadow-sm border border-neutral-200 p-8 flex flex-col items-center justify-center text-center">
          <h3 class="text-xl font-bold text-primary mb-4">Book an Appointment</h3>
          <p class="text-neutral-600 text-sm mb-6">Use our online booking system to schedule your consultation at a time that suits you.</p>
          <a href="https://app.elle.health/book-appointment?practice=8ujneQja%2BEUTnAYhIdK%2Fvw%3D%3D" target="_blank" rel="noopener noreferrer" class="inline-block bg-accent hover:bg-accent-light text-white font-semibold px-8 py-3 rounded-lg transition-colors text-lg">
            Book Now
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
